; Coding style and analyzer configuration.
; See https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/configuration-files
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
max_line_length = 120

[*.{json,yml,yaml,md,ps1,psm1,csproj,props,targets,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

; Generated code (Unicode tables, source generators) is excluded from analysis.
[*.g.cs]
generated_code = true

[*.cs]
; --- Language conventions -------------------------------------------------
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_accessors = when_on_single_line:suggestion
csharp_style_expression_bodied_lambdas = when_on_single_line:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion
dotnet_style_prefer_conditional_expression_over_return = false:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = false:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning

; --- Formatting -----------------------------------------------------------
; A `case X:` followed by a braced block: the .NET formatter indents the block one level past the
; label, CSharpier keeps it level with the label, and IDE0055 is an error here - so the two
; disagreeing made a braced case unwritable. CSharpier is this repository's formatter of record
; (`dotnet csharpier format .`, enforced on pre-commit and in CI), so the .NET formatter is told to
; agree with it. Added S15, where Engine/ ports C switch statements whose cases declare locals.
csharp_indent_case_contents_when_block = false

; A `goto` label: the .NET formatter's default (`one_less_than_current`) outdents it, CSharpier
; leaves it at the surrounding indent, and IDE0055 is an error here - so a label CSharpier had
; formatted failed the build immediately afterwards. Same conflict and same resolution as the line
; above: CSharpier is the formatter of record, so the .NET formatter is told to agree with it.
; Added S16, where Engine/Matcher.cs ports basic_match's `start_match`, `next_match_2` and
; `backtrack` labels.
csharp_indent_labels = no_change

; --- Naming ---------------------------------------------------------------
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

; --- Global analyzer adjustments -----------------------------------------
; CA1051: Do not declare visible instance fields.
; Matching-state structs expose fields deliberately; properties cost indirection on hot paths.
;
; INCOMPLETE, and deliberately left that way for now. The struct this was written for does not
; exist yet - the Engine arrives in Phase 3 - so CA1051 fires zero times today. When it does
; land, this line alone will NOT be enough: Sonar's S1104 says the same thing, is not suppressed
; anywhere, and defaults to warning, which TreatWarningsAsErrors turns into a build error on
; exactly that shape. MA0008 (add StructLayoutAttribute) fires on it too. Measured 2026-08-31
; against this file unmodified, with a representative struct at src/FuzzyRegex/Engine/ZState.cs:
;   ZState.cs(7,16): error S1104: Make this field 'private' and encapsulate it in a 'public' property.
;   ZState.cs(4,15): error MA0008: Add StructLayoutAttribute
; Add S1104 and MA0008 in the engine scope in the slice that lands the struct, not before -
; suppressing rules for code that does not exist yet only hides findings in the meantime.
dotnet_diagnostic.CA1051.severity = none

; MA0002/MA0011: require an explicit StringComparer/IFormatProvider.
; InvariantGlobalization is on and the engine is ordinal by construction; the rule fires
; constantly on ordinal-by-definition code and hides real findings.
dotnet_diagnostic.MA0002.severity = none
dotnet_diagnostic.MA0011.severity = none

; MA0048: file name must match type name. Ported files are named after their upstream
; counterpart and may hold the small helper types upstream declares alongside.
dotnet_diagnostic.MA0048.severity = suggestion

; ==========================================================================
; Faithful-port relaxations.
;
; src/FuzzyRegex/Parsing, src/FuzzyRegex/Engine and src/FuzzyRegex/Unicode are hand-ports of
; _regex_core.py, _regex.c and _regex_unicode.c. Their shape must track upstream so that upstream
; diffs map mechanically onto our files (design spec section 4) and so `sync-upstream` stays a
; mechanical exercise. Rules that would force restructuring - method length, complexity, nesting,
; magic numbers - are therefore suppressed here and here only. Correctness and security rules are
; untouched.
;
; Unicode/ was added in S09. Its hand-written files are the C helpers _regex_core.py calls
; (unicode_has_property, the encoding tables, the module-level functions) plus the four generated
; lookup functions the transliterator cannot shape; its *.g.cs files are marked generated_code
; above and see no analysis at all.
;
; Removing a suppression is a deliberate act: it means that area has been optimised away from
; upstream's structure on purpose, and PORTMAP.md should say so.
; ==========================================================================
[src/FuzzyRegex/{Parsing,Engine,Unicode}/**.cs]
; Method is too long / has too many lines.
dotnet_diagnostic.MA0051.severity = none
dotnet_diagnostic.S138.severity = none
; Cognitive and cyclomatic complexity.
dotnet_diagnostic.S3776.severity = none
dotnet_diagnostic.S1541.severity = none
dotnet_diagnostic.CA1502.severity = none
; Too many parameters / too many boolean conditions / nesting depth / too many cases.
dotnet_diagnostic.S107.severity = none
dotnet_diagnostic.S1067.severity = none
dotnet_diagnostic.S134.severity = none
dotnet_diagnostic.S1479.severity = none
; Magic numbers: bytecode opcodes and table offsets are numeric by nature.
dotnet_diagnostic.S109.severity = none
; Commented-out code: upstream C/Python lines are quoted beside their port as the reference.
dotnet_diagnostic.S125.severity = none
; Switch should have a default / if-else chains: ports mirror upstream dispatch exactly.
dotnet_diagnostic.S131.severity = none
; NotImplementedException: members land slice by slice; the parity ratchet, not an analyzer,
; is what proves an unimplemented member is still unimplemented.
dotnet_diagnostic.MA0025.severity = none
; S3871: exceptions must be public. Upstream's ParseError, _UnscopedFlagSet and _FirstSetError
; are control flow inside the parser - one rewinds the scanner, one restarts the parse, one
; skips an optimisation. Making them public would put three types nobody can usefully catch on
; the shipped surface, which is a restructuring, not a fix. Added S07.
dotnet_diagnostic.S3871.severity = none

[src/FuzzyRegex/Engine/**.cs]
; S907: remove this use of 'goto'. Added S16, and narrower than the block above on purpose - the
; parser and the Unicode tables contain no 'goto' and must not start containing one.
;
; What the rule wants is structured control flow, and it is right about ordinary code. It is wrong
; about this file. 'basic_match' (upstream/src/_regex.c:11714-17403) is a backtracking machine whose
; two loops - the dispatch switch and the backtrack switch - jump into each other and back to the
; search restart, and every one of the 'goto's here is one of upstream's, at the same place, with
; the same label name. Structuring them away means inventing a control-flow scheme upstream does not
; have, in the one function most upstream fixes land in, which is the cost this port exists to avoid
; (AGENTS.md, design spec section 4). The decision to keep upstream's shape is recorded in
; DECISIONS 2026-08-31.
dotnet_diagnostic.S907.severity = none

; --- Tests ----------------------------------------------------------------
[tests/**/*.cs]
; Long, vertically-structured test methods are more readable than extracted helpers.
dotnet_diagnostic.MA0051.severity = none
dotnet_diagnostic.S138.severity = none
; Underscores in test names: ported tests carry their upstream Python method name.
dotnet_diagnostic.CA1707.severity = none
; Assertions live in AwesomeAssertions extension methods the analyzer cannot see.
dotnet_diagnostic.S2699.severity = none
; Test data literals.
dotnet_diagnostic.S109.severity = none
dotnet_diagnostic.CA1861.severity = none
; Sonar disables these two in test code of its own accord, but it detects a test project by
; looking for a test framework it recognises among the references, and it does not know TUnit.
; Until S10 the projects also referenced NSubstitute, which it DOES know, so the classification
; worked by accident; removing that unused dependency made both rules start firing. Restoring
; Sonar's own intent explicitly, rather than keeping a mock library nothing uses as a marker.
; S1313 reads upstream's regex test patterns - 'a::bc', 'b::c', '192.168.0.1' - as hardcoded IP
; addresses. They are pattern strings copied from the suite we are a port of; editing them would
; corrupt the test data.
dotnet_diagnostic.S1313.severity = none
; S3011 flags reflection over non-public members. ApiSurfaceTests exists precisely to assert that
; no mutable non-public state has crept into the public types, so the accessibility bypass is the
; test rather than a risk in it.
dotnet_diagnostic.S3011.severity = none

; ==========================================================================
; API surface stub (S01), src/FuzzyRegex root only.
;
; The public API exists as signatures before the parser and engine do, because the ported test
; suite cannot compile against types that are not there (design spec section 15, amendment 2).
; Every member throws NotImplementedException, which makes three rules fire on every one of them
; for reasons that are true of a stub and false of the finished type.
;
; DELETE THIS BLOCK IN PHASE 2, when the members gain bodies. If it survives past then it starts
; hiding real findings, which is the opposite of what it is for.
; ==========================================================================
[src/FuzzyRegex/*.cs]
; NotImplementedException: the point of the slice.
dotnet_diagnostic.MA0025.severity = none
; "Make this a static method": true only while the body ignores instance state.
dotnet_diagnostic.S2325.severity = none
; "Remove unused parameter": true only while the body ignores its arguments.
dotnet_diagnostic.IDE0060.severity = none

