<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Fuzzy.Text.RegularExpressions.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires optimised, non-attached builds to produce valid numbers. -->
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FuzzyRegex/FuzzyRegex.csproj" />
  </ItemGroup>

</Project>
