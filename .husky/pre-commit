#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Identity first, before anything slower: see .husky/check-identity.sh.
sh "$(dirname "$0")/check-identity.sh" commit || exit 1

# Formatting, then the IDE-only inspections; deliberately NOT the test suite. The suite runs on
# pre-push and in CI; a pre-commit hook that ran it would double the test time of every unattended
# slice (the driver has already run check-ratchet.ps1 seconds earlier) and would refuse the
# failing-test commits that test-first development is made of. Reasoning in full:
# docs/plan/slices/done/S01b.
#
# The inspections step was added 2026-09-12 by owner decision: Rider reports "Anonymous function
# can be made static" (IDE0320) as an ERROR, `dotnet build` on the .NET 10.0.400 SDK never reports
# it at all (DECISIONS), and the CI job that does was not on any path a commit had to pass through -
# S36 committed one such lambda the same day the gate was written. So the gate runs here, on every
# commit that stages a .cs file. It takes about four minutes; that is the price of not shipping
# what the IDE calls an error. Docs-only commits skip it.

# Deletions included here, and only here: a deleted test changes the counts on docs/STATUS.md just
# as a new one does, while the formatting step below has nothing to format in a file that is gone.
staged_tests=$(git diff --cached --name-only --diff-filter=ACMRD -z -- 'tests/*.cs' | tr '\0' '\n')

staged=$(git diff --cached --name-only --diff-filter=ACMR -z -- '*.cs' | tr '\0' '\n')
[ -z "$staged" ] && [ -z "$staged_tests" ] && exit 0

# A file that is staged *and* has further unstaged edits cannot be re-staged safely: the
# `git add` below would sweep those edits into the commit. Refuse rather than commit content
# nobody chose.
partial=$(printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 git diff --name-only --)
if [ -n "$partial" ]; then
  echo "pre-commit: partially staged, so formatting cannot be re-staged safely:"
  printf '%s\n' "$partial" | sed 's/^/  /'
  echo "Stage them fully, or run 'dotnet csharpier format .' and stage the result."
  exit 1
fi

if [ -n "$staged" ]; then
  printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 dotnet csharpier format || exit 1
  printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 git add
fi

# docs/STATUS.md is generated from a test RUN, so a commit that changes the tests without
# re-running the ratchet ships a page describing a different set of them. CI catches that by
# regenerating the page on three runners and comparing (run 35569653546, 2026-09-21); this catches
# it here, in milliseconds, by comparing the stamp the ratchet wrote beside the page with the tests
# actually being committed. tools/status-stamp.ps1 says what the stamp covers.
#
# After the formatting above, deliberately: the stamp then describes the bytes that are committed.
if [ -n "$staged_tests" ]; then
  recorded=$(tr -d '\r\n' < tests/status-stamp.txt 2>/dev/null)
  actual=$(pwsh -NoProfile -File tools/status-stamp.ps1 | tr -d '\r\n')
  if [ "$recorded" != "$actual" ]; then
    echo "pre-commit: the tests have changed since docs/STATUS.md was generated."
    echo "  recorded: ${recorded:-(no tests/status-stamp.txt)}"
    echo "  actual:   $actual"
    echo "Run 'pwsh -File tools/check-ratchet.ps1', then stage docs/STATUS.md and tests/status-stamp.txt."
    exit 1
  fi
fi

[ -z "$staged" ] && exit 0

# ReSharper's command-line inspector over the whole solution, ERROR severity, --no-build (the
# caller has built; the ratchet always has). Fails the commit on any finding.
echo "pre-commit: running IDE inspections (about four minutes) ..."
# Per-process output path: on 2026-09-15 two concurrent commits shared one file and the second
# committer's inspection read the first's results.
inspect_out=".scratch/inspect-precommit-$$.xml"
pwsh -NoProfile -File tools/check-inspections.ps1 -Output "$inspect_out" || {
  echo "pre-commit: IDE inspections RED - fix the findings above (or see $inspect_out)."
  exit 1
}
